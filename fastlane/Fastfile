default_platform(:ios)

API_KEY_ID     = "33P5W93GJQ"
API_ISSUER_ID  = "ed28e2d3-ce1d-4d24-8e58-373132e4b554"
API_KEY_PATH   = ENV.fetch("ASC_KEY_PATH", File.expand_path("AuthKey_33P5W93GJQ.p8", __dir__))

platform :ios do

  desc "XcodeGen으로 Xcode 프로젝트 생성"
  lane :generate do
    sh("cd .. && xcodegen generate")
  end

  desc "App Store Connect에 앱 등록"
  lane :create_app do
    produce(
      username: "sukhaverse@gmail.com",
      app_identifier: "com.blueCode.SimplePenNote",
      app_name: "SimplePenNote",
      language: "ko",
      app_version: "1.0.0",
      sku: "com.blueCode.SimplePenNote",
      platforms: ["ios"],
      team_id: "KUDC7C6Z9H",
      enable_services: {
        icloud: "cloudkit"
      }
    )
  end

  desc "빌드된 IPA만 App Store Connect에 업로드"
  lane :upload_binary do
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: "com.blueCode.SimplePenNote",
      app_version: "1.0",
      ipa: "./build/SimplePenNote.ipa",
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true
      }
    )
  end

  desc "메타데이터 + 스크린샷만 업로드 (빌드 건너뜀)"
  lane :upload_only do
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: "com.blueCode.SimplePenNote",
      app_version: "1.0",
      ipa: "./build/SimplePenNote.ipa",
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      skip_metadata: false,
      skip_screenshots: false,
      skip_binary_upload: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true
      }
    )
  end

  desc "앱 가격 무료 설정 + 메타데이터 업로드"
  lane :set_free do
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: "com.blueCode.SimplePenNote",
      app_version: "1.0",
      price_tier: 0,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      skip_metadata: false,
      skip_screenshots: false,
      skip_binary_upload: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true
      }
    )
  end

  desc "App Store 제출용 빌드 + 메타데이터 + 스크린샷 업로드"
  lane :release do
    generate

    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )

    build_num = [(latest_testflight_build_number(api_key: api_key, initial_build_number: 0) rescue 9), 9].max + 1
    UI.message("Using build number: #{build_num}")

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.blueCode.SimplePenNote",
      team_id: "KUDC7C6Z9H",
      adhoc: false,
      force: true
    )

    increment_build_number(
      build_number: build_num,
      xcodeproj: "SimplePenNote.xcodeproj"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "SimplePenNote.xcodeproj",
      team_id: "KUDC7C6Z9H",
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["SIGH_NAME"] || "com.blueCode.SimplePenNote AppStore"
    )

    build_app(
      project: "SimplePenNote.xcodeproj",
      scheme: "SimplePenNote",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "SimplePenNote.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.blueCode.SimplePenNote" => ENV["SIGH_NAME"] || "com.blueCode.SimplePenNote AppStore"
        }
      }
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: "com.blueCode.SimplePenNote",
      app_version: "1.0",
      ipa: "./build/SimplePenNote.ipa",
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      skip_metadata: false,
      skip_screenshots: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true
      }
    )
  end

  desc "현재 MARKETING_VERSION 의 App Store 버전에 메타데이터 + 스크린샷 업로드 (바이너리·심사 제출 없음)"
  lane :store_metadata do
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )
    spec = YAML.load_file(File.expand_path("../project.yml", __dir__))
    version = spec.fetch("settings").fetch("base").fetch("MARKETING_VERSION").to_s

    deliver(
      api_key: api_key,
      app_identifier: "com.blueCode.SimplePenNote",
      app_version: version,          # creates the version draft if it doesn't exist yet
      skip_app_version_update: false,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "현재 버전/빌드의 TestFlight 처리 상태 조회 (업로드 없음)"
  lane :beta_status do
    app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )
    spec = YAML.load_file(File.expand_path("../project.yml", __dir__))
    version = spec.fetch("settings").fetch("base").fetch("MARKETING_VERSION").to_s
    number = spec.fetch("settings").fetch("base").fetch("CURRENT_PROJECT_VERSION").to_s
    app = Spaceship::ConnectAPI::App.find("com.blueCode.SimplePenNote")
    UI.user_error!("App not found") unless app
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, build_number: number).first
    upload = Spaceship::ConnectAPI::BuildUpload.all(app_id: app.id, version: version, build_number: number).first
    UI.message(JSON.pretty_generate({
      version: version,
      build: number,
      build_id: build&.id,
      processing: build&.processing_state,
      internal_testing: build&.build_beta_detail&.internal_build_state,
      expired: build&.expired,
      upload_state: upload&.state
    }))
  end

  desc "TestFlight 배포 (iOS)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )

    # Fail on API errors rather than guessing a build number already used by Apple.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.blueCode.SimplePenNote",
      initial_build_number: 0
    )
    spec_path = File.expand_path("../project.yml", __dir__)
    spec = File.read(spec_path)
    local_build = spec.match(/CURRENT_PROJECT_VERSION:\s*(\d+)/)[1].to_i
    build_num = [latest.to_i + 1, local_build].max
    spec = spec.sub(/CURRENT_PROJECT_VERSION:\s*\d+/, "CURRENT_PROJECT_VERSION: #{build_num}")
    spec = spec.sub(/CFBundleVersion:\s*"\d+"/, "CFBundleVersion: \"#{build_num}\"")
    File.write(spec_path, spec)
    UI.message("Using build number: #{build_num}")
    generate

    # Reuse a valid distribution profile; do not revoke or regenerate it on every beta.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.blueCode.SimplePenNote",
      team_id: "KUDC7C6Z9H",
      adhoc: false,
      provisioning_name: "com.blueCode.SimplePenNote AppStore C599C444",
      output_path: "./build/signing",
      readonly: true
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "SimplePenNote.xcodeproj",
      targets: ["SimplePenNote"],
      team_id: "KUDC7C6Z9H",
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["SIGH_NAME"] || "com.blueCode.SimplePenNote AppStore C599C444"
    )

    build_app(
      project: "SimplePenNote.xcodeproj",
      scheme: "SimplePenNote",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "SimplePenNote.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.blueCode.SimplePenNote" => ENV["SIGH_NAME"] || "com.blueCode.SimplePenNote AppStore C599C444"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.blueCode.SimplePenNote",
      ipa: "./build/SimplePenNote.ipa",
      changelog: File.read(File.expand_path("metadata/ko/release_notes.txt", __dir__)),
      distribute_external: false,
      notify_external_testers: false,
      skip_waiting_for_build_processing: false,
      wait_processing_interval: 30,
      wait_processing_timeout_duration: 1800
    )
  end
end
