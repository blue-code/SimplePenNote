        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手書きの周りの余白を自動で削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필기 주변 여백 자동 제거"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动去除笔迹周围空白"
          }
        }
      }
    },
    "필기 한눈에 보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fit Writing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手書き全体を表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필기 한눈에 보기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看全部笔迹"
          }
        }
      }
    },
    "필기가 있는 부분을 선택해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an area with writing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手書きがある部分を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필기가 있는 부분을 선택해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择有笔迹的部分。"
          }
        }
      }
    },
    "필요한 부분을 사각형으로 드래그하세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a rectangle around what you need"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な部分を四角くドラッグしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 부분을 사각형으로 드래그하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖出矩形框选需要的部分"
          }
        }
      }
    },
    "필요한 부분을 사각형으로 드래그하세요. 아래 전체 필기 선택 버튼도 사용할 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a rectangle around what you need, or use Select All Writing below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な部分を四角くドラッグしてください。下の「手書きをすべて選択」も使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 부분을 사각형으로 드래그하세요. 아래 전체 필기 선택 버튼도 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖出矩形框选需要的部分，也可以使用下方的“选择全部笔迹”。"
          }
        }
      }
    },
    "한 번 결제, 계속 사용": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay once, use forever"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入でずっと使える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 결제, 계속 사용"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次购买，永久使用"
          }
        }
      }
    },
    "한 번 그려두고,\n계속 꺼내 쓰세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw it once.\nReuse it anytime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度描いたら、\n何度でも使える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 그려두고,\n계속 꺼내 쓰세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画一次，\n随时取用。"
          }
        }
      }
    },
    "한 번 그려두고, 필요할 때 다시 꺼내 쓰세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw it once and reuse it whenever you need it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度描いておけば、必要なときにいつでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 그려두고, 필요할 때 다시 꺼내 쓰세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画一次，需要时随时取用。"
          }
        }
      }
    },
    "한 주의 일정과 할 일": {
