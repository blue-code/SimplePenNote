  "sourceLanguage": "ko",
  "strings": {
    "%@ · 평생 Pro 잠금 해제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Unlock Pro for Life"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@・Proを永久にアンロック"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 평생 Pro 잠금 해제"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 永久解锁 Pro"
          }
        }
      }
    },
