          }
        }
      }
    },
    "짧은 메모와 스케치를 워터마크 없이 깔끔하게 공유하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share quick notes and sketches cleanly, without a watermark."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短いメモやスケッチを透かしなしですっきり共有しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 메모와 스케치를 워터마크 없이 깔끔하게 공유하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无水印地分享短笔记和草图。"
          }
        }
      }
    },
    "첫 영감": {
      "localizations": {
        "en": {
