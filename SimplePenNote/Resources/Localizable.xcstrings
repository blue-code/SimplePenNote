    "PDF 문서로 공유": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share as PDF"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFで共有"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 문서로 공유"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 PDF 分享"
          }
        }
      }
    },
    "PDF는 종이 전체를 한 페이지로 저장합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF saves the whole paper as one page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFは用紙全体を1ページとして保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF는 종이 전체를 한 페이지로 저장합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 会将整张纸保存为一页。"
          }
        }
      }
    },
    "PDF로 묶기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine into PDF"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFにまとめる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF로 묶기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并为 PDF"
          }
        }
      }
    },
    "PNG 미리보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PNG Preview"
          }
        },
        "ja": {
