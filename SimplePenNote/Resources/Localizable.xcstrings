        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PNG 预览"
          }
        }
      }
    },
    "PNG 이미지로 공유": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share as PNG"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PNG画像で共有"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PNG 이미지로 공유"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 PNG 图片分享"
          }
        }
      }
    },
    "PNG는 한 페이지씩 내보낼 수 있습니다. 여러 페이지는 PDF를 선택해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PNG exports one page at a time. Choose PDF for multiple pages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PNGは1ページずつ書き出せます。複数ページはPDFを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PNG는 한 페이지씩 내보낼 수 있습니다. 여러 페이지는 PDF를 선택해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PNG 每次只能导出一页。多页请选择 PDF。"
          }
        }
      }
    },
    "Pro": {
      "localizations": {
        "en": {
