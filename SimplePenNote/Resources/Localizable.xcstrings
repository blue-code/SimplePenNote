    "%lld일 후 영구 삭제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted permanently in %lld days"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld日後に完全に削除"
          }
        },
        "ko": {
