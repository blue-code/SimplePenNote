    "노트를 파일로 만들지 못했습니다. 다시 시도해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't create the file. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを作成できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 파일로 만들지 못했습니다. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法生成文件。请重试。"
          }
        }
      }
    },
    "노트에 넣기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insert into Note"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートに挿入"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트에 넣기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入笔记"
          }
        }
      }
    },
    "노트에 이미 넣은 필기는 그대로 남습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handwriting already inserted into notes stays as it is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートに挿入済みの手書きはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트에 이미 넣은 필기는 그대로 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已插入笔记的笔迹会保留。"
          }
        }
      }
    },
    "노트에서 부분 선택 → 미리보기 → 보관함에 저장을 누르세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a note, tap Select → Preview → Save to Library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートで部分選択 → プレビュー → ライブラリに保存の順にタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트에서 부분 선택 → 미리보기 → 보관함에 저장을 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在笔记中依次点按 部分选择 → 预览 → 存入手写库。"
          }
        }
      }
    },
    "다시 실행": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やり直す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 실행"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重做"
          }
        }
      }
    },
    "다음 아이디어도\n계속 기록하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep every next idea\ncoming."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のアイデアも\n書き続けよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 아이디어도\n계속 기록하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一个灵感，\n也继续记下来。"
          }
        }
      }
    },
    "다음에도 꺼내 쓰기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reuse Later"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで使う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에도 꺼내 쓰기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次继续用"
          }
        }
      }
    },
    "닫기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "떠오른 생각을 마음껏 쓰고, 원하는 곳에 꺼내 쓰세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write down every thought, then use it anywhere you like."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思いついたことを自由に書いて、好きな場所で使いましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "떠오른 생각을 마음껏 쓰고, 원하는 곳에 꺼내 쓰세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽情写下想法，在任何地方取用。"
          }
        }
      }
    },
    "모눈": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grid"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方眼"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모눈"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方格"
          }
        }
      }
    },
    "모든 템플릿은 무료입니다. 나중에 종이를 바꿔도 필기는 그대로 남습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All templates are free. Your writing stays put if you change paper later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのテンプレートは無料です。あとで用紙を変えても手書きはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 템플릿은 무료입니다. 나중에 종이를 바꿔도 필기는 그대로 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有模板均免费。之后更换纸张，笔迹也会保留。"
          }
        }
      }
    },
    "무료 내보내기에는 SimplePenNote 워터마크가 표시됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free exports include a SimplePenNote watermark."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料の書き出しにはSimplePenNoteの透かしが入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 내보내기에는 SimplePenNote 워터마크가 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费导出会带有 SimplePenNote 水印。"
          }
        }
      }
    },
    "무료 버전에서도 페이지 %lld장, 모든 기본 서식, 워터마크가 있는 PNG·PDF 내보내기를 사용할 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free version includes %lld pages, every paper template, and PNG/PDF export with a watermark."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版でも%lldページ、すべての用紙テンプレート、透かし入りのPNG・PDF書き出しが使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 버전에서도 페이지 %lld장, 모든 기본 서식, 워터마크가 있는 PNG·PDF 내보내기를 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版也可使用 %lld 页、所有纸张模板，以及带水印的 PNG/PDF 导出。"
          }
        }
      }
    },
    "무료 페이지 %lld장을 모두 사용했습니다. Pro로 제한 없이 이어가세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used all %lld free pages. Keep going without limits with Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料の%lldページをすべて使いました。Proなら制限なく続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 페이지 %lld장을 모두 사용했습니다. Pro로 제한 없이 이어가세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 页免费页面已用完。升级 Pro 即可不限页数。"
          }
        }
      }
    },
    "무료로 계속 사용": {
      "localizations": {
