            "value": "Write as many quick notes and ideas as you like"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短いメモや思いつきを好きなだけ記録"
          }
        },
        "ko": {
          "stringUnit": {
