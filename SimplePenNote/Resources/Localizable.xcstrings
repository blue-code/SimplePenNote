    "%@을 투명 PNG로 복사했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied %@ as a transparent PNG."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を透過PNGとしてコピーしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을 투명 PNG로 복사했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将%@复制为透明 PNG。"
          }
        }
      }
    },
