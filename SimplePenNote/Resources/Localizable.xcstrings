    },
    "자주 쓰는 손글씨를 모아보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect the handwriting you use often"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う手書きを集めよう"
          }
        },
        "ko": {
